name: "upsDemoValue20260914"
func
doc: "Synthetic UPS values, stripping time-component units before arithmetic."
src:
  (p, ts) =>
  do
    fraction: (ts.time.hour.as(1) + ts.time.minute.as(1) / 60) / 12 - 1
    if (p->kind == "Number") p->upsBase + p->upsAmplitude * fraction else p->upsBase
  end

