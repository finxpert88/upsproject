do
  if (readAll(point and upsDemo).size != 138) throw "Unexpected UPS point count"
  if (readAll(upsDemoFill).size != 0) throw "Backfill already requested; reconcile"
  cutoff: now().floor(5min)
  upsDemoTick20260914()
  readAll(point and upsDemo and upsSupported==true and upsScenario=="offline" and upsLogicalField!="communicationStatus").each(p => do
    lastGood: cutoff - 30min
    diff(p, {curVal:upsDemoValue20260914(p, lastGood), curStatus:"down", upsQuality:"stale", upsSourceTs:lastGood, upsLastGoodAt:lastGood}, {transient}).commit
  end)
  diff(readById(@p:mytest:r:323a812d-d8928336), {-disabled}).commit
  commit(diff(null, {job, upsDemoFill, upsDemo, demoBatch:"upsDemo20260914", dis:"UPS演示 30天历史回填", upsFillState:"pending", upsFillCutoff:cutoff, upsCompletedPoints:0, jobExpr:"do\n  state: read(upsDemoFill)\n  cutoff: state->upsFillCutoff\n  diff(state, {upsFillState:\"running\", upsCompletedPoints:0}).commit\n  points: readAll(point and upsDemo and his and upsSupported==true).toRecList\n  points.each(p => do\n    upsDemoBackfill20260914(p, cutoff)\n    latest: read(upsDemoFill)\n    diff(latest, {upsCompletedPoints:latest->upsCompletedPoints + 1, upsLastCompletedPoint:p->id}).commit\n  end)\n  diff(readById(@p:mytest:r:323a812d-97f4a5fc), {-disabled}).commit\n  diff(read(upsDemoFill), {upsFillState:\"done\", upsFinishedAt:now()}).commit\n  {completedPoints:points.size, cutoff:cutoff}\nend", jobSchedule:"onetime " + (now() + 10sec).toStr}, {add}))
  {phase:"automatic-fill-scheduled", points:138, historyPoints:88, cutoff:cutoff}
end
