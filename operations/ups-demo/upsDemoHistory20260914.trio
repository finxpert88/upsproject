name: "upsDemoHistory20260914"
func
doc: "UPS demo only; synthetic data; restricted to upsDemo records."
src:
  () =>
  do
    cutoff: now().floor(5min)
    readAll(point and upsDemo and his and upsSupported==true and upsScenario!="offline").each(p => do
      if (p["hisEnd"] == null or p->hisEnd < cutoff)
        [{ts:cutoff, val:upsDemoValue20260914(p, cutoff)}].hisWrite(p)
    end)
    {sampleTime:cutoff}
  end

